{
  "name": "outpost",
  "version": "0.2.0",
  "description": "A local-only mail app for your own Resend API key. Desktop and Android.",
  "main": "main.js",
  "license": "MIT",
  "author": "Maharshi Patel",
  "homepage": "https://github.com/maharshi878/outpost#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maharshi878/outpost.git"
  },
  "bugs": {
    "url": "https://github.com/maharshi878/outpost/issues"
  },
  "keywords": [
    "resend",
    "email",
    "mail",
    "electron",
    "capacitor",
    "android",
    "byok",
    "local-first",
    "privacy"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.js test/vault.test.js",
    "dist": "electron-builder",
    "apk": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^7.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.outpost.mail",
    "productName": "Outpost",
    "files": [
      "main.js",
      "preload.js",
      "vault.js",
      "app/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
