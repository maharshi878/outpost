{
  "name": "outpost",
  "version": "0.2.0",
  "description": "A local-only mail app for your own Resend API key. Desktop and Android.",
  "main": "main.js",
  "license": "MIT",
  "author": "Outpost contributors",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "apk": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.outpost.mail",
    "productName": "Outpost",
    "files": ["main.js", "preload.js", "app/**"],
    "mac": { "category": "public.app-category.productivity", "target": ["dmg"] },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage"], "category": "Office" }
  }
}
